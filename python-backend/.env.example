# =====================================================================
# 注意：本项目不再使用 SiliconFlow。
# 模型接口为 Cline 提供的本地 OpenAI 兼容 API：
#   Base URL : http://localhost:8787/v1
#   Model    : cline-free/mimo-v2.6-flash
#
# API Key 请写入 python-backend/.streamlit/secrets.toml：
#   LLM_API_KEY = "你的密钥"
# 该文件已被 .gitignore 排除，**不要**提交到 Git。
# =====================================================================

# 可选：仅用于命令行测试时覆盖默认配置（正式运行走 secrets.toml）
# LLM_API_KEY=仅本地测试用，不要提交
# LLM_BASE_URL=http://localhost:8787/v1
# MODEL_NAME=cline-free/mimo-v2.6-flash
